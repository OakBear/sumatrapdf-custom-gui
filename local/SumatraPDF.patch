+extern bool gRestoringSessionSnapshot;
+
+// Record only an actually loaded PDF; do not create history for transient tabs.
+static void RememberPdfViewed(WindowTab* tab, bool duringStartup = false) {
+    if (!tab || (!duringStartup && gIsStartup) || gPluginMode || tab->skipHistory ||
+        !tab->win || tab->win->isQuickLook || !SettingsRememberOpenedFiles() ||
+        IsOpenCachePath(tab->filePath) || path::IsEphemeralHostFile(tab->filePath) ||
+        !tab->AsFixed() || !EngineMupdfIsPdf(tab->AsFixed()->GetEngine())) {
+        return;
+    }
+    FileState* ds = FileHistoryFindByPath(tab->filePath);
+    if (!ds) {
+        return;
+    }
+    SYSTEMTIME now{};
+    GetSystemTime(&now);
+    str::ReplaceWithCopy(&ds->lastOpenedUtc,
+                         fmt("%04u-%02u-%02uT%02u:%02u:%02uZ", now.wYear, now.wMonth, now.wDay,
+                             now.wHour, now.wMinute, now.wSecond));
+    ScheduleSaveSettings();
+}
