+static void CALLBACK OnSessionSnapshotTimer(HWND, UINT, UINT_PTR, DWORD) {
+    logf("session snapshot timer fired\n");
+    if (!gIsStartup && !gDontSaveSettings && len(gWindows) > 0) {
+        SaveSettingsNow();
+    }
+    // The idle sweep in the render cache needs a periodic kick: when nothing is
+    // being rendered Add() isn't called, so the TTL would never be evaluated.
+    if (gRenderCache) {
+        gRenderCache->TrimIdleEntries();
+    }
+}
