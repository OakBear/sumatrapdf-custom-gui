+// Drop entries that haven't been painted for kCacheIdleTtlMs. This is the
+// "idle timeout" half of the memory policy: closing a document already frees
+// its cache, but a document left open in a background tab would otherwise keep
+// its tiles until the count/byte limit pushes them out.
+void RenderCache::TrimIdleEntries() {
+    static u64 lastTrim = 0;
+    u64 now = GetTickCount64();
+    // don't walk the cache on every rendered tile
+    if (lastTrim && now - lastTrim < 5000) {
+        return;
+    }
+    lastTrim = now;
+    int nDropped = 0;
+    size_t freed = 0;
+    // must go from the end: dropping an entry moves the last one into its slot
+    for (int i = cacheCount - 1; i >= 0; i--) {
+        BitmapCacheEntry* e = cache[i];
+        if (e->refs > 1 || e->lastUse == 0) {
+            continue;
+        }
+        if (now - e->lastUse < kCacheIdleTtlMs) {
+            continue;
+        }
+        // never drop what a document currently shows, even if it hasn't been
+        // painted for a while (minimized window, background tab)
+        if (e->dm && e->dm->PageVisibleNearby(e->pageNo)) {
+            continue;
+        }
+        freed += (size_t)e->byteSize;
+        if (DropCacheEntryIfNotUsed(e)) {
+            nDropped++;
+        }
+    }
+    if (nDropped > 0) {
+        logf("RenderCache: dropped %d idle entries (%d MB)\n", nDropped, (int)(freed / (1024 * 1024)));
+    }
+}
