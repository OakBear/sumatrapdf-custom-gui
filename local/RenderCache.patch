+// Byte budget for rendered tiles, the counterpart of PDF-XChange Editor's
+// configurable page-cache limit. It's a soft target: tiles that are visible
+// right now are never evicted, so a single huge page can exceed it.
+size_t RenderCache::CacheBudgetBytes() {
+    // 256 MB is ~60 tiles of 1024x1024x4 bytes. Measured working sets while
+    // scrolling a 200-page document stay around 60-70 MB, so this leaves room
+    // for several screens of history at deep zoom while bounding the worst
+    // case (256 entries at 1024x1024x4 would be ~1 GB).
+    static constexpr size_t kBudget = (size_t)256 * 1024 * 1024;
+    return kBudget;
+}
+
+// entries not painted for this long are dropped unless their page is visible
+constexpr u64 kCacheIdleTtlMs = 5 * 60 * 1000;
