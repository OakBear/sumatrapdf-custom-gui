+// defined in TableOfContents.cpp: the Bookmarks pane shows the user's
+// bookmarks above the document outline, so it has to follow these changes
+void RefreshBookmarksForFavoritesChange(MainWindow* win);
+
+// true if the document shown in win has user bookmarks (Ctrl+B)
+bool HasUserBookmarks(MainWindow* win) {
+    WindowTab* tab = win ? win->CurrentTab() : nullptr;
+    if (!tab || len(tab->filePath) == 0) {
+        return false;
+    }
+    FileState* fs = GetFavByFilePath(tab->filePath);
+    return fs && fs->favorites && len(*fs->favorites) > 0;
+}
+
 void UpdateFavoritesTreeForAllWindows() {
     for (MainWindow* win : gWindows) {
         UpdateFavoritesTree(win);
+        RefreshBookmarksForFavoritesChange(win);
     }
