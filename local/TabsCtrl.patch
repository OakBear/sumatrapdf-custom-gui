+// Bring a selected tab into view without undoing a manual wheel scroll on layout.
+static void EnsureSelectedVisible(TabsCtrl* tabs) {
+    TabsViewport* viewport = GetTabsViewport(tabs);
+    TabCtrl* tab = tabs->TabCtrlAt(tabs->selectedIdx);
+    if (!viewport || !tab || viewport->bounds.dx <= 0) return;
+    Rect view = viewport->BoundsInWindow();
+    Rect r = tab->BoundsInWindow();
+    int shift = 0;
+    if (r.dx > view.dx) {
+        shift = IsTabsRtl(tabs->hwnd) ? view.Right() - r.Right() : view.x - r.x;
+    } else if (r.x < view.x) {
+        shift = view.x - r.x;
+    } else if (r.Right() > view.Right()) {
+        shift = view.Right() - r.Right();
+    }
+    if (shift) {
+        viewport->offset += IsTabsRtl(tabs->hwnd) ? shift : -shift;
+        tabs->LayoutTabs();
     }
 }
 
