+// A viewport clips both painting and hit testing. Its state survives child rebuilds.
+struct TabsViewport : VirtCtrl {
+    int offset = 0;
+    int maxOffset = 0;
+    int wheelRemainder = 0;
+    TabsViewport() { flags |= vwfClipChildren | vwfNoHitTest; }
+    void PaintChildren(VirtPaintCtx& ctx) override {
+        ctx.gfx->PushClip(ctx.clip);
+        VirtCtrl::PaintChildren(ctx);
+        ctx.gfx->PopClip();
+    }
+};
+
+static TabsViewport* GetTabsViewport(TabsCtrl* tabs) {
+    return tabs->ChildCount() ? (TabsViewport*)tabs->ChildAt(0) : nullptr;
+}
