+//--- Fixed button for the list of all tabs
+
+static bool TriggerSelectionChanging(TabsCtrl* tabs);
+static void TriggerSelectionChanged(TabsCtrl* tabs);
+
+struct TabsListBtn : VirtCtrl {
+    TabsCtrl* tabsCtrl = nullptr;
+    TabsListBtn() {
+        colorDefaults = gColsTab;
+        nColors = kColTabCount;
+        cursor = CursorId::Hand;
+        onMouseEnter = MkMethod0<TabsListBtn, &TabsListBtn::OnInvalidate>(this);
+        onMouseLeave = MkMethod0<TabsListBtn, &TabsListBtn::OnInvalidate>(this);
+        onClick = MkMethod1<TabsListBtn, VirtMouseEvent*, &TabsListBtn::OnClick>(this);
+    }
+    void OnInvalidate() { Invalidate(); }
+    void Paint(VirtPaintCtx& ctx) override {
+        Rect r = ctx.bounds;
+        Color bg = GetColor(kColTabBg);
+        if (HasFlag(vwfHovered)) {
+            bg = AccentColor(GetColor(kColTabInactiveBg), 10);
+            ctx.gfx->FillRect(r, bg);
+        }
+        Color col = TabTextColorForBackground(GetColor(kColTabText), bg);
+        int x = r.x + r.dx / 2;
+        int y = r.y + r.dy / 2;
+        int arm = std::max(1, DpiScale(4));
+        ctx.gfx->DrawLineAA({x - arm, y - arm / 2}, {x, y + arm / 2}, col, 2.0f, 255);
+        ctx.gfx->DrawLineAA({x, y + arm / 2}, {x + arm, y - arm / 2}, col, 2.0f, 255);
+    }
+    void OnClick(VirtMouseEvent*) {
+        TabsCtrl* tabs = tabsCtrl;
+        HWND hwnd = tabs->hwnd;
+        HMENU menu = CreatePopupMenu();
+        if (!menu) return;
+        Vec<TabInfo*> entries;
+        for (int i = 0; i < tabs->TabCount(); i++) {
+            TabInfo* tab = tabs->GetTab(i);
+            VecAppend(entries, tab);
+            // Numbering distinguishes identical titles and escaping keeps '&' literal.
+            std::wstring label = std::to_wstring(i + 1) + L". ";
+            const WCHAR* title = CWStrTemp(tab->text);
+            if (title) {
+                for (const WCHAR* c = title; *c; c++) {
+                    if (*c == L'&') label += L'&';
+                    label += *c;
+                }
+            }
+            AppendMenuW(menu, MF_STRING | (i == tabs->selectedIdx ? MF_CHECKED : 0), i + 1, label.c_str());
+        }
+        Rect r = BoundsInWindow();
+        POINT pt = {r.Right(), r.Bottom()};
+        ClientToScreen(hwnd, &pt);
+        int cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTALIGN | TPM_RIGHTBUTTON,
+                                 pt.x, pt.y, 0, hwnd, nullptr);
+        DestroyMenu(menu);
+        // The menu pumps messages; the window or tab list may have changed.
+        if (!IsWindow(hwnd) || (TabsCtrl*)GetWindowLongPtrW(hwnd, GWLP_USERDATA) != tabs ||
+            cmd <= 0 || cmd > len(entries)) return;
+        int idx = VecFind(tabs->tabs, entries[cmd - 1]);
+        if (idx < 0 || idx == tabs->selectedIdx) return;
+        bool prevent = TriggerSelectionChanging(tabs);
+        if (prevent || !IsWindow(hwnd) || (TabsCtrl*)GetWindowLongPtrW(hwnd, GWLP_USERDATA) != tabs) return;
+        idx = VecFind(tabs->tabs, entries[cmd - 1]);
+        if (idx < 0) return;
+        tabs->SetSelected(idx);
+        TriggerSelectionChanged(tabs);
+    }
+};
